export component App inherits Window {
    width: 1024px;
    height: 768px;
    title: "Ospro";

    in-out property <string> brew-state: "Idle";
    in-out property <float> temperature: 93.0;
    in-out property <float> pressure: 9.0;
    in-out property <duration> timer: 0ms;

    callback start-brew();
    callback stop-brew();
    callback reset();

    VerticalLayout {
        padding: 20px;
        spacing: 20px;

        Text {
            text: "Ospro WS6 MVP";
            color: black;
            font-size: 32px;
            horizontal-alignment: center;
        }

        Rectangle {
            VerticalLayout {
                Text { text: "Status: {brew-state}"; font-size: 24px; }
                Text { text: "Temp: {temperature}°C"; font-size: 24px; }
                Text { text: "Pressure: {pressure} bar"; font-size: 24px; }
                Text { text: "Timer: {timer}"; font-size: 24px; }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            TouchArea {
                clicked => { root.start-brew(); }
                Rectangle { width: 120px; height: 60px; background: green; Text { text: "Start"; color: white; } }
            }
            TouchArea {
                clicked => { root.stop-brew(); }
                Rectangle { width: 120px; height: 60px; background: red; Text { text: "Stop"; color: white; } }
            }
            TouchArea {
                clicked => { root.reset(); }
                Rectangle { width: 120px; height: 60px; background: blue; Text { text: "Reset"; color: white; } }
            }
        }
    }
}